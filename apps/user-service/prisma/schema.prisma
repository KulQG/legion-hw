generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  email              String    @unique
  name               String    @db.VarChar(30)
  bio                String?   @db.VarChar(1000)
  birthDate          DateTime  @map("birth_date") @db.Timestamptz(3)
  balance            Decimal   @default(0) @db.Decimal(14, 2)
  currentAvatar      String?   @map("current_avatar")
  activeAvatarsCount Int       @default(0) @map("active_avatars_count")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)
  passwordHash       String    @map("password_hash")

  avatars           Avatar[]
  outgoingTransfers Transfer[] @relation("OutgoingTransfers")
  incomingTransfers Transfer[] @relation("IncomingTransfers")

  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, where: raw("deleted_at IS NULL"))
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, where: raw("deleted_at IS NULL"))
  @@index([activeAvatarsCount, id(sort: Desc)], where: raw("deleted_at IS NULL"))
  @@index([birthDate, id(sort: Desc)], where: raw("deleted_at IS NULL"))
  @@map("users")
}

model Avatar {
  id        String    @id
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  userId    String    @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@index([userId], where: raw("deleted_at IS NULL"))
  @@index([userId, createdAt(sort: Desc)])
  @@map("avatars")
}

model Transfer {
  id             String   @id @default(uuid(7)) @db.Uuid
  fromAccountId  String   @map("from_account_id") @db.Uuid
  toAccountId    String   @map("to_account_id") @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key")
  sum            Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  fromUser User @relation("OutgoingTransfers", fields: [fromAccountId], references: [id])
  toUser   User @relation("IncomingTransfers", fields: [toAccountId], references: [id])

  @@index([fromAccountId, id(sort: Desc)])
  @@map("transfers")
}

model Outbox {
  id          Int       @id @default(autoincrement())
  topic       String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  claimId     String?   @map("claim_id") @db.Uuid
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)

  @@index([id(sort: Asc)], where: raw("processed_at IS NULL"))
  @@map("outbox")
}
