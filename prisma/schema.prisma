generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model User {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String   @unique
  name      String   @db.VarChar(30)
  bio       String?  @db.VarChar(1000)
  birthDate DateTime @map("birth_date")

  passwordHash String @map("password_hash")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  currentAvatar      String?  @map("current_avatar")
  activeAvatarsCount Int      @default(0) @map("active_avatars_count")
  avatars            Avatar[]

  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, where: raw("deleted_at IS NULL"))
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, where: raw("deleted_at IS NULL"))
  @@index([activeAvatarsCount], where: raw("deleted_at IS NULL AND CRE"))
  @@index([birthDate], where: raw("deleted_at IS NULL"))
  @@map("users")
}

model Avatar {
  id        String    @id
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id") @db.Uuid

  @@index([userId], where: raw("deleted_at IS NULL"))
  @@index([userId, createdAt(sort: Desc)])
  @@map("avatars")
}
